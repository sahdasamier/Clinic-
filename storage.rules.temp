rules_version = '2';

// ✅ TEMPORARY DEVELOPMENT RULES - ALLOWS ALL OPERATIONS
// WARNING: This is for development only - DO NOT use in production
service firebase.storage {
  match /b/{bucket}/o {
    
    // ✅ TEMPORARY: Allow all operations for development
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}

