# Firebase Configuration
# Get these values from your Firebase Project Settings > General > Your apps > Web app config
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Application Configuration
# Set to 'development' for local development, 'production' for production builds
NODE_ENV=development

# Optional: Email configuration (if using email features)
# VITE_EMAIL_SERVICE_ID=your_email_service_id
# VITE_EMAIL_TEMPLATE_ID=your_email_template_id
# VITE_EMAIL_PUBLIC_KEY=your_email_public_key

# Optional: Development mode settings
# VITE_DEBUG_MODE=false
# VITE_ENABLE_ANALYTICS=true