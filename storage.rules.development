rules_version = '2';

// ✅ DEVELOPMENT MODE: More permissive storage rules for testing
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true || 
        request.auth.token.email == 'sahdasamier013@gmail.com'
      );
    }
    
    function hasRole(role) {
      return request.auth != null && request.auth.token.role == role;
    }
    
    function isSameClinic(clinicId) {
      return request.auth != null && request.auth.token.clinicId == clinicId;
    }
    
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    function isValidImageFile() {
      return request.resource.contentType.matches('image/.*');
    }
    
    function isValidDocumentFile() {
      return request.resource.contentType.matches('application/pdf') ||
             request.resource.contentType.matches('application/msword') ||
             request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.*') ||
             request.resource.contentType.matches('text/plain');
    }
    
    function isValidMedicalFile() {
      return isValidImageFile() || isValidDocumentFile();
    }
    
    function isValidFileSize(maxSizeMB) {
      return request.resource.size <= maxSizeMB * 1024 * 1024;
    }
    
    // ✅ DEVELOPMENT MODE: More permissive rules for testing
    // Patient documents - authenticated users can read/write
    match /patients/{patientId}/documents/{category}/{fileName} {
      allow read, write: if isAuthenticated() && 
        isValidMedicalFile() && isValidFileSize(15);
      allow delete: if isAuthenticated();
    }
    
    // Patient images - authenticated users
    match /patients/{patientId}/images/{fileName} {
      allow read, write: if isAuthenticated() && 
        isValidImageFile() && isValidFileSize(5);
      allow delete: if isAuthenticated();
    }
    
    // Patient avatars - authenticated users
    match /patients/{patientId}/avatar/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && 
        isValidImageFile() && isValidFileSize(2);
      allow delete: if isAuthenticated();
    }
    
    // Prescription documents - authenticated users
    match /prescriptions/{appointmentId}/{fileName} {
      allow read, write: if isAuthenticated() && 
        (isValidDocumentFile() || isValidImageFile()) && isValidFileSize(10);
      allow delete: if isAuthenticated();
    }
    
    // Clinic documents - authenticated users
    match /clinics/{clinicId}/{type}/{fileName} {
      allow read, write: if isAuthenticated() && 
        isValidMedicalFile() && isValidFileSize(20);
      allow delete: if isAuthenticated();
    }
    
    // Clinic branding - authenticated users
    match /clinics/{clinicId}/branding/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && 
        isValidImageFile() && isValidFileSize(5);
      allow delete: if isAuthenticated();
    }
    
    // Lab results - authenticated users
    match /lab_results/{patientId}/{fileName} {
      allow read, write: if isAuthenticated() && 
        isValidMedicalFile() && isValidFileSize(10);
      allow delete: if isAuthenticated();
    }
    
    // Insurance documents - authenticated users
    match /insurance/{patientId}/{fileName} {
      allow read, write: if isAuthenticated() && 
        isValidMedicalFile() && isValidFileSize(5);
      allow delete: if isAuthenticated();
    }
    
    // Medical records - authenticated users
    match /medical_records/{patientId}/{fileName} {
      allow read, write: if isAuthenticated() && 
        isValidMedicalFile() && isValidFileSize(20);
      allow delete: if isAuthenticated();
    }
    
    // Inventory item images - authenticated users
    match /laboratoryRadiology/{clinicId}/{itemId}/{fileName} {
      allow read, write: if isAuthenticated() && 
        isValidImageFile() && isValidFileSize(5);
      allow delete: if isAuthenticated();
    }
    
    // Backup files - admins only
    match /backups/{fileName} {
      allow read, write, delete: if isAuthenticated() && isAdmin();
    }
    
    // Temporary uploads - authenticated users
    match /temp/{userId}/{fileName} {
      allow read, write: if isAuthenticated() && isOwner(userId) &&
        isValidMedicalFile() && isValidFileSize(50);
      allow delete: if isAuthenticated() && 
        (isOwner(userId) || isAdmin());
    }
    
    // Public assets - anyone can read, authenticated users can write
    match /public/{fileName} {
      allow read: if true;
      allow write, delete: if isAuthenticated();
    }
    
    // Default deny rule for any other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
